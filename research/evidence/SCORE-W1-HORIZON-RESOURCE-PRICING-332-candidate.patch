@@ -0,0 +1,235 @@
+#include "udon/horizon_pricing.hpp"
+#include "udon/orienteering.hpp"
+#include <map>
+#include <tuple>
+
+namespace udon {
+namespace {
+struct Exhausted {};
+struct InvalidWitness {};
+constexpr std::uint64_t kSettled = 32768;
+constexpr std::uint64_t kCreated = 196609;
+constexpr std::uint64_t kActions = 262144;
+constexpr std::uint64_t kMemo = 8192;
+constexpr std::uint64_t kTransitions = 262144;
+constexpr std::uint64_t kQueries = 1024;
+
+class Pricing {
+    const MatchConfig& config;
+    const DayState& root;
+    const MatchLedger& ledger;
+    const FutureWitness& original;
+    const ExactStepSimulator& simulator;
+    const IndependentDayValidator& validator;
+    std::chrono::steady_clock::time_point deadline;
+    HorizonPricingDiagnostics& totals;
+    HorizonPricingDiagnostics work;
+    std::vector<std::vector<std::uint32_t>> fixedClaims;
+    std::vector<std::vector<AgentState>> fixedStates;
+    using DayKey = std::tuple<std::int32_t, CellId, std::int32_t>;
+    std::map<DayKey, std::vector<ExactOrienteeringRoute>> dayCache;
+    using Key = std::tuple<std::int32_t, CellId, std::int32_t, BrandMask>;
+    struct Choice {
+        OfficialScore score;
+        CellId pos = kInvalidCell;
+        std::int32_t fuel = 0;
+        BrandMask brands;
+        const ExactOrienteeringRoute* route = nullptr;
+    };
+    std::map<Key, Choice> memo;
+    AgentIndex agent = 0;
+
+    void check() const {
+        if (std::chrono::steady_clock::now() >= deadline) throw Exhausted{};
+    }
+    void charge(std::uint64_t amount) {
+        check();
+        if (amount > kTransitions - work.transitions) throw Exhausted{};
+        work.transitions += amount;
+    }
+    void charge_actions(std::uint64_t amount) {
+        check();
+        if (amount > kActions - work.storedActions) throw Exhausted{};
+        work.storedActions += amount;
+    }
+    SimulationResult simulate(const DayState& state, const DayPlan& plan) {
+        // Charge both full-team engines before entering their bounded loops.
+        charge(2ULL * static_cast<std::uint64_t>(config.agent_count()) *
+               static_cast<std::uint64_t>(config.steps_for_day(state.dayNumber)));
+        auto s = simulator.simulate(state, plan, true);
+        check();
+        auto v = validator.validate(state, plan, true);
+        check();
+        std::string mismatch;
+        if (!s.valid || !validator.agrees_with(s, v, mismatch)) throw InvalidWitness{};
+        return s;
+    }
+    std::pair<BrandMask, std::int32_t> day_score(std::int32_t day, std::uint32_t chosen) const {
+        BrandMask brands;
+        std::int32_t servings = 0;
+        const auto& masks = fixedClaims.at(day - root.dayNumber);
+        for (std::size_t spot = 0; spot < config.spots.size(); ++spot) {
+            const auto bit = std::uint32_t{1} << static_cast<std::uint32_t>(spot);
+            std::int32_t claims = (chosen & bit) != 0U ? 1 : 0;
+            for (AgentIndex a = 0; a < config.agent_count(); ++a)
+                if (a != agent && (masks.at(a) & bit) != 0U) ++claims;
+            if (claims > 0) {
+                brands |= brand_bit(config.spots.at(spot).brandIndex);
+                servings += std::min(claims, config.spots.at(spot).stock);
+            }
+        }
+        return {brands, servings};
+    }
+    const std::vector<ExactOrienteeringRoute>& routes(std::int32_t day, CellId pos, std::int32_t fuel) {
+        check();
+        const DayKey key{day, pos, fuel};
+        if (const auto i = dayCache.find(key); i != dayCache.end()) return i->second;
+        if (work.dayQueries >= kQueries || work.settledLabels >= kSettled ||
+            work.createdLabels >= kCreated || work.storedActions >= kActions) throw Exhausted{};
+        ++work.dayQueries;
+        DayState state = root;
+        state.dayNumber = day;
+        state.agents.at(agent).position = pos;
+        state.agents.at(agent).fuel = fuel;
+        auto frontier = enumerate_horizon_resource_frontier(
+            config, state, agent, kSettled - work.settledLabels,
+            kCreated - work.createdLabels, kActions - work.storedActions, deadline);
+        work.settledLabels += frontier.settledStates;
+        work.createdLabels += frontier.createdLabels;
+        work.storedActions += frontier.storedPlanActions;
+        check();
+        if (!frontier.supported || !frontier.complete || frontier.routes.empty()) throw Exhausted{};
+        return dayCache.emplace(key, std::move(frontier.routes)).first->second;
+    }
+    const Choice& solve(std::int32_t day, CellId pos, std::int32_t fuel, const BrandMask& brands) {
+        charge(1);
+        const Key key{day, pos, fuel, brands};
+        if (const auto i = memo.find(key); i != memo.end()) return i->second;
+        if (work.memoStates >= kMemo) throw Exhausted{};
+        ++work.memoStates;
+        if (day > config.day_count()) {
+            return memo.emplace(key, Choice{{brand_count(brands), 0, 0}, pos, fuel, brands, nullptr}).first->second;
+        }
+        std::optional<Choice> best;
+        for (const auto& route : routes(day, pos, fuel)) {
+            charge(1);
+            const auto [dailyBrands, servings] = day_score(day, route.spotMask);
+            const BrandMask nextBrands = brands | dailyBrands;
+            auto value = solve(day + 1, route.terminalCell, fuel - route.patrolFuel, nextBrands).score;
+            value.totalDailyDistinct += brand_count(dailyBrands);
+            value.totalServings += servings;
+            if (!best || best->score < value)
+                best = Choice{value, route.terminalCell, fuel - route.patrolFuel, nextBrands, &route};
+        }
+        if (!best) throw InvalidWitness{};
+        return memo.emplace(key, std::move(*best)).first->second;
+    }
+public:
+    Pricing(const MatchConfig& c, const DayState& s, const MatchLedger& l,
+            const FutureWitness& w, const ExactStepSimulator& sim,
+            const IndependentDayValidator& val, std::chrono::steady_clock::time_point end,
+            HorizonPricingDiagnostics& d)
+        : config(c), root(s), ledger(l), original(w), simulator(sim), validator(val),
+          deadline(end), totals(d) {}
+    ~Pricing() {
+        totals.settledLabels += work.settledLabels;
+        totals.createdLabels += work.createdLabels;
+        totals.storedActions += work.storedActions;
+        totals.memoStates += work.memoStates;
+        totals.transitions += work.transitions;
+        totals.dayQueries += work.dayQueries;
+    }
+    std::optional<FutureWitness> run() {
+        if (!original.certified || original.lowerBoundOnly || original.futurePlans.size() !=
+            static_cast<std::size_t>(config.day_count() - root.dayNumber + 1)) throw InvalidWitness{};
+        auto state = root;
+        auto prefix = ledger;
+        std::uint64_t originalActions = 0;
+        for (const auto& plan : original.futurePlans) {
+            check();
+            for (const auto& actions : plan.actions) {
+                originalActions += actions.size();
+                if (originalActions > kActions) throw Exhausted{};
+                charge_actions(actions.size());
+            }
+            auto sim = simulate(state, plan);
+            std::vector<std::uint32_t> masks(static_cast<std::size_t>(config.agent_count()), 0U);
+            for (const auto& claim : sim.claims)
+                masks.at(claim.agent) |= std::uint32_t{1} << static_cast<std::uint32_t>(claim.spot);
+            fixedClaims.push_back(std::move(masks));
+            fixedStates.push_back(sim.finalAgents);
+            state.agents = sim.finalAgents;
+            ++state.dayNumber;
+            prefix.apply(sim.score);
+        }
+        if (OfficialScore{prefix.lifetime_distinct(), prefix.totalDailyDistinct, prefix.totalServings} != original.score)
+            throw InvalidWitness{};
+        std::optional<FutureWitness> best;
+        for (agent = 0; agent < config.agent_count(); ++agent) {
+            // The daily route geometry is identity-independent for Patrols;
+            // the shared cache is safe, while joint-stock DP is rebuilt per agent.
+            memo.clear();
+            auto expected = solve(root.dayNumber, root.agents.at(agent).position,
+                                  root.agents.at(agent).fuel, ledger.lifetimeBrands).score;
+            expected.totalDailyDistinct += ledger.totalDailyDistinct;
+            expected.totalServings += ledger.totalServings;
+            if (expected < original.score) throw InvalidWitness{};
+            FutureWitness candidate;
+            candidate.certified = true;
+            auto actual = root;
+            auto actualLedger = ledger;
+            for (std::int32_t day = root.dayNumber; day <= config.day_count(); ++day) {
+                check();
+                const auto node = solve(day, actual.agents.at(agent).position,
+                                        actual.agents.at(agent).fuel, actualLedger.lifetimeBrands);
+                const auto& originalPlan = original.futurePlans.at(day - root.dayNumber);
+                for (const auto& actions : originalPlan.actions) charge_actions(actions.size());
+                charge_actions(node.route->actions.size());
+                auto plan = originalPlan;
+                plan.actions.at(agent) = node.route->actions;
+                const auto sim = simulate(actual, plan);
+                for (AgentIndex a = 0; a < config.agent_count(); ++a)
+                    if (a != agent && (sim.finalAgents.at(a).position != fixedStates.at(day - root.dayNumber).at(a).position ||
+                        sim.finalAgents.at(a).fuel != fixedStates.at(day - root.dayNumber).at(a).fuel)) throw InvalidWitness{};
+                if (sim.finalAgents.at(agent).position != node.pos || sim.finalAgents.at(agent).fuel != node.fuel)
+                    throw InvalidWitness{};
+                actualLedger.apply(sim.score);
+                if (actualLedger.lifetimeBrands != node.brands) throw InvalidWitness{};
+                actual.agents = sim.finalAgents;
+                ++actual.dayNumber;
+                candidate.futurePlans.push_back(std::move(plan));
+            }
+            candidate.score = {actualLedger.lifetime_distinct(), actualLedger.totalDailyDistinct, actualLedger.totalServings};
+            if (candidate.score != expected) throw InvalidWitness{};
+            if (original.score < candidate.score && (!best || best->score < candidate.score)) best = std::move(candidate);
+        }
+        check();
+        ++totals.completed;
+        if (best) ++totals.improvements;
+        return best;
+    }
+};
+}
+
+std::optional<FutureWitness> price_horizon_witness(
+    const MatchConfig& config, const DayState& root, const MatchLedger& ledger,
+    const FutureWitness& original, const ExactStepSimulator& simulator,
+    const IndependentDayValidator& validator,
+    std::chrono::steady_clock::time_point deadline, HorizonPricingDiagnostics& diagnostics) {
+    ++diagnostics.calls;
+    if (!config.roadCells.empty() || config.spots.empty() || config.spots.size() > 32U ||
+        root.dayNumber < 1 || root.dayNumber > config.day_count() ||
+        std::any_of(root.agents.begin(), root.agents.end(), [](const auto& a) { return a.kind != AgentKind::Patrol; }))
+        return std::nullopt;
+    ++diagnostics.supported;
+    deadline = std::min(deadline, std::chrono::steady_clock::now() + std::chrono::milliseconds{100});
+    try {
+        return Pricing(config, root, ledger, original, simulator, validator, deadline, diagnostics).run();
+    } catch (const Exhausted&) {
+        ++diagnostics.exhausted;
+    } catch (const InvalidWitness&) {
+        ++diagnostics.failures;
+    }
+    return std::nullopt;
+}
+}
