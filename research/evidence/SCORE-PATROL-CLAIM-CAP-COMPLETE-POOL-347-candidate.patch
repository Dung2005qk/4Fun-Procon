+namespace {
+std::string witness_bytes(const FutureWitness& witness) {
+    std::string bytes = std::to_string(witness.certified) + ":" +
+        std::to_string(witness.lowerBoundOnly) + ":";
+    for (const DayPlan& plan : witness.futurePlans) {
+        const std::string planBytes = canonical_plan_bytes(plan);
+        bytes += std::to_string(planBytes.size()) + ":" + planBytes;
+    }
+    return bytes;
+}
