+std::size_t LexicographicRiskComparator::choose_undominated(
+    const std::vector<CandidateEvaluation>& evaluations,
+    bool requireUndominatedCurrentFloor,
+    std::vector<bool>& dominated) const {
+    dominated.assign(evaluations.size(), false);
+    for (std::size_t i = 0; i < evaluations.size(); ++i) {
+        for (std::size_t j = 0; j < evaluations.size(); ++j) {
+            if (i != j && certified_dominates(evaluations.at(j).profile, evaluations.at(i).profile)) {
+                dominated.at(i) = true;
+                break;
+            }
+        }
+    }
+    std::vector<CandidateEvaluation> eligible;
+    std::vector<std::size_t> indices;
+    for (std::size_t i = 0; i < evaluations.size(); ++i) {
+        if (!dominated.at(i)) {
+            eligible.push_back(evaluations.at(i));
+            indices.push_back(i);
+        }
+    }
+    if (eligible.empty()) {
+        throw std::runtime_error("all certified candidates were unexpectedly dominated");
+    }
+    return indices.at(choose(eligible, requireUndominatedCurrentFloor));
+}
