+void refine_complete_w1_pool(
+    const MatchConfig& config, const DayState& currentState, const MatchLedger& ledger,
+    std::vector<CandidateEvaluation>& pool, const ExactStepSimulator& simulator,
+    const IndependentDayValidator& validator,
+    std::chrono::steady_clock::time_point deadline, CompletePoolPricingAudit& audit,
+    const HorizonPricingLimits& limits) {
+    audit.entered = true;
+    audit.originalPoolSize = pool.size();
+    for (CandidateEvaluation& evaluation : pool) {
+        const MasterCandidate& candidate = evaluation.candidate;
+        const std::string originalPlan = canonical_plan_bytes(candidate.plan);
+        for (std::size_t i = 0; i < evaluation.profile.outcomes.size(); ++i) {
+            ScenarioOutcome& outcome = evaluation.profile.outcomes.at(i);
+            PoolPricingOutcomeAudit record;
+            record.candidateId = candidate.stableId;
+            record.scenarioIndex = i;
+            record.beforeScore = outcome.score;
+            record.beforeWitness = witness_bytes(outcome.witness);
+            if (outcome.witness.certified && !outcome.witness.lowerBoundOnly &&
+                currentState.dayNumber < config.day_count()) {
+                DayState root = currentState;
+                root.dayNumber = currentState.dayNumber + 1;
+                root.agents = candidate.simulation.finalAgents;
+                MatchLedger nextLedger = ledger;
+                nextLedger.apply(candidate.simulation.score);
+                const auto priced = price_horizon_witness(
+                    config, root, nextLedger, outcome.witness, simulator, validator,
+                    deadline, evaluation.profile.horizonPricing, limits);
+                if (priced.has_value() && outcome.witness.score < priced->score) {
+                    outcome = ScenarioOutcome{priced->score, *priced};
+                    record.replaced = true;
+                    ++audit.replacements;
+                }
+            }
+            record.afterScore = outcome.score;
+            record.afterWitness = witness_bytes(outcome.witness);
+            if (!record.replaced && (record.beforeScore != record.afterScore ||
+                                    record.beforeWitness != record.afterWitness)) {
+                audit.noGainPoolUnchanged = false;
+            }
+            audit.outcomes.push_back(std::move(record));
+        }
+        audit.currentPlansUnchanged = audit.currentPlansUnchanged &&
+            originalPlan == canonical_plan_bytes(candidate.plan);
+    }
+    if (!audit.noGainPoolUnchanged || !audit.currentPlansUnchanged) {
+        throw std::runtime_error("complete-pool pricing changed a protected original");
+    }
+}
+
+std::optional<FutureWitness> price_horizon_witness(
+    const MatchConfig& config, const DayState& root, const MatchLedger& ledger,
+    const FutureWitness& original, const ExactStepSimulator& simulator,
+    const IndependentDayValidator& validator,
+    std::chrono::steady_clock::time_point deadline, HorizonPricingDiagnostics& diagnostics, const HorizonPricingLimits& requested) {
+    auditCuts = 0;
+    ++diagnostics.calls;
+    if (!config.roadCells.empty() || config.spots.empty() || config.spots.size() > 32U ||
+        root.dayNumber < 1 || root.dayNumber > config.day_count() ||
+        std::any_of(root.agents.begin(), root.agents.end(), [](const auto& a) { return a.kind != AgentKind::Patrol; }))
+        return std::nullopt;
+    ++diagnostics.supported;
+    deadline = std::min(deadline, std::chrono::steady_clock::now() + std::chrono::milliseconds{100});
+    // Fault injection can only LOWER limits, never escalate production caps.
+    const HorizonPricingLimits defaults;
+    const HorizonPricingLimits bounded{
+        std::min(requested.settled, defaults.settled), std::min(requested.created, defaults.created),
+        std::min(requested.actions, defaults.actions), std::min(requested.memo, defaults.memo),
+        std::min(requested.transitions, defaults.transitions), std::min(requested.queries, defaults.queries)};
+    try {
+        return Pricing(config, root, ledger, original, simulator, validator, deadline, diagnostics, bounded).run();
+    } catch (const Exhausted&) {
+        ++diagnostics.exhausted;
+    } catch (const InvalidWitness&) {
+        ++diagnostics.failures;
+    } catch (const std::bad_alloc&) {
+        ++diagnostics.exhausted;
+    }
+    return std::nullopt;
+}
