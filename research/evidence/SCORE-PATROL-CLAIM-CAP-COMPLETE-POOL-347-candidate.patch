+++ b/src/horizon_pricing.cpp
@@ -0,0 +1,435 @@
+#include "udon/horizon_pricing.hpp"
+#include "udon/orienteering.hpp"
+#include "udon/protocol.hpp"
+#include <array>
+#include <bit>
+#include <map>
+#include <set>
+#include <tuple>
+
+namespace udon {
+namespace {
+thread_local std::uint64_t auditCuts = 0;
+struct Exhausted {};
+struct InvalidWitness {};
+
+class Pricing {
+    const MatchConfig& config;
+    const DayState& root;
+    const MatchLedger& ledger;
+    const FutureWitness& original;
+    const ExactStepSimulator& simulator;
+    const IndependentDayValidator& validator;
+    std::chrono::steady_clock::time_point deadline;
+    HorizonPricingDiagnostics& totals;
+    HorizonPricingDiagnostics work;
+    std::vector<std::vector<std::uint32_t>> fixedClaims;
+    std::vector<std::vector<AgentState>> fixedStates;
+    using DayKey = std::tuple<std::int32_t, CellId, std::int32_t>;
+    std::map<DayKey, std::vector<ExactOrienteeringRoute>> dayCache;
+    using Cells = std::array<CellId, 2>;
+    using Fuels = std::array<std::int32_t, 2>;
+    using Key = std::tuple<std::int32_t, Cells, Fuels, BrandMask>;
+    struct Choice {
+        OfficialScore score;
+        Cells pos{};
+        Fuels fuel{};
+        BrandMask brands;
+        std::array<const ExactOrienteeringRoute*, 2> route{};
+    };
+    std::map<Key, Choice> memo;
+    std::array<AgentIndex, 2> pair{};
+    HorizonPricingLimits limits;
+    struct Relaxation {
+        std::uint32_t creditMask = 0;
+        std::int32_t fixedSuffix = 0;
+        std::int32_t capacitySuffix = 0;
+    };
+    std::vector<Relaxation> relaxed;
+    std::map<DayKey, std::int32_t> upperMemo;
+    BrandMask allBrands;
+
+
+    void check() const {
+        if (std::chrono::steady_clock::now() >= deadline) throw Exhausted{};
+    }
+    void charge(std::uint64_t amount) {
+        check();
+        if (amount > limits.transitions - work.transitions) throw Exhausted{};
+        work.transitions += amount;
+    }
+    void charge_actions(std::uint64_t amount) {
+        check();
+        if (amount > limits.actions - work.storedActions) throw Exhausted{};
+        work.storedActions += amount;
+    }
+    SimulationResult simulate(const DayState& state, const DayPlan& plan) {
+        // Charge both full-team engines before entering their bounded loops.
+        charge(2ULL * static_cast<std::uint64_t>(config.agent_count()) *
+               static_cast<std::uint64_t>(config.steps_for_day(state.dayNumber)));
+        auto s = simulator.simulate(state, plan, true);
+        check();
+        auto v = validator.validate(state, plan, true);
+        check();
+        std::string mismatch;
+        if (!s.valid || !validator.agrees_with(s, v, mismatch)) throw InvalidWitness{};
+        return s;
+    }
+    std::pair<BrandMask, std::int32_t> day_score(std::int32_t day, std::uint32_t first, std::uint32_t second) const {
+        BrandMask brands;
+        std::int32_t servings = 0;
+        const auto& masks = fixedClaims.at(day - root.dayNumber);
+        for (std::size_t spot = 0; spot < config.spots.size(); ++spot) {
+            const auto bit = std::uint32_t{1} << static_cast<std::uint32_t>(spot);
+            std::int32_t claims = ((first & bit) != 0U ? 1 : 0) + ((second & bit) != 0U ? 1 : 0);
+            for (AgentIndex a = 0; a < config.agent_count(); ++a)
+                if (a != pair[0] && a != pair[1] && (masks.at(a) & bit) != 0U) ++claims;
+            if (claims > 0) {
+                brands |= brand_bit(config.spots.at(spot).brandIndex);
+                servings += std::min(claims, config.spots.at(spot).stock);
+            }
+        }
+        return {brands, servings};
+    }
+    const std::vector<ExactOrienteeringRoute>& routes(std::int32_t day, CellId pos, std::int32_t fuel) {
+        check();
+        const DayKey key{day, pos, fuel};
+        if (const auto i = dayCache.find(key); i != dayCache.end()) return i->second;
+        if (work.dayQueries >= limits.queries || work.settledLabels >= limits.settled ||
+            work.createdLabels >= limits.created || work.storedActions >= limits.actions) throw Exhausted{};
+        ++work.dayQueries;
+        DayState state = root;
+        state.dayNumber = day;
+        const AgentIndex agent = pair[0]; // Geometry/fuel independent of physical Patrol identity.
+        state.agents.at(agent).position = pos;
+        state.agents.at(agent).fuel = fuel;
+        auto frontier = enumerate_horizon_resource_frontier(
+            config, state, agent, limits.settled - work.settledLabels,
+            limits.created - work.createdLabels, limits.actions - work.storedActions, deadline);
+        work.settledLabels += frontier.settledStates;
+        work.createdLabels += frontier.createdLabels;
+        work.storedActions += frontier.storedPlanActions;
+        check();
+        if (!frontier.supported || !frontier.complete || frontier.routes.empty()) throw Exhausted{};
+        return dayCache.emplace(key, std::move(frontier.routes)).first->second;
+    }
+    void prepare_relaxation() {
+        upperMemo.clear();
+        relaxed.clear();
+        allBrands = {};
+        for (std::size_t day = 0; day < fixedClaims.size(); ++day) {
+            charge(1);
+            charge_actions(3); // Three bounded scalar records per day.
+            Relaxation item;
+            for (std::size_t spot = 0; spot < config.spots.size(); ++spot) {
+                charge(1 + static_cast<std::uint64_t>(config.agent_count()));
+                const auto bit = std::uint32_t{1} << static_cast<std::uint32_t>(spot);
+                std::int32_t claims = 0;
+                for (AgentIndex a = 0; a < config.agent_count(); ++a)
+                    if (a != pair[0] && a != pair[1] && (fixedClaims[day][a] & bit)) ++claims;
+                const auto stock = config.spots[spot].stock;
+                item.fixedSuffix += std::min(claims, stock);
+                item.capacitySuffix += std::min(claims + 2, stock);
+                if (claims < stock) item.creditMask |= bit;
+                allBrands |= brand_bit(config.spots[spot].brandIndex);
+            }
+            relaxed.push_back(item);
+        }
+        for (std::size_t i = relaxed.size(); i > 1; --i) {
+            charge(1);
+            relaxed[i - 2].fixedSuffix += relaxed[i - 1].fixedSuffix;
+            relaxed[i - 2].capacitySuffix += relaxed[i - 1].capacitySuffix;
+        }
+    }
+    std::int32_t solo_upper(std::int32_t day, CellId pos, std::int32_t fuel) {
+        charge(1);
+        if (day > config.day_count()) return 0;
+        const DayKey key{day, pos, fuel};
+        if (const auto i = upperMemo.find(key); i != upperMemo.end()) return i->second;
+        if (work.memoStates >= limits.memo) throw Exhausted{};
+        ++work.memoStates; // Relaxation shares, never adds to, the registered cap.
+        const auto credit = relaxed.at(day - root.dayNumber).creditMask;
+        std::int32_t best = 0;
+        for (const auto& route : routes(day, pos, fuel)) {
+            charge(1);
+            const auto now = std::popcount(route.spotMask & credit);
+            const auto later = solo_upper(day + 1, route.terminalCell, fuel - route.patrolFuel);
+            best = std::max(best, now + later);
+        }
+        upperMemo.emplace(key, best);
+        return best;
+    }
+    OfficialScore optimistic(std::int32_t day, Cells pos, Fuels fuel, const BrandMask& brands) {
+        charge(1);
+        if (day > config.day_count()) return {brand_count(brands), 0, 0};
+        const auto& r = relaxed.at(day - root.dayNumber);
+        // Fixed-team stock plus independent residual credits OVERestimates
+        // joint reward: shared residual stock is deliberately not subtracted.
+        const auto upper = r.fixedSuffix + solo_upper(day, pos[0], fuel[0])
+                                        + solo_upper(day, pos[1], fuel[1]);
+        return {brand_count(brands | allBrands),
+                (config.day_count() - day + 1) * brand_count(allBrands),
+                std::min(r.capacitySuffix, upper)};
+    }
+    std::vector<const ExactOrienteeringRoute*> terminal_representatives(
+            const std::vector<ExactOrienteeringRoute>& frontier) {
+        // Final-day quotient only. Keep the earliest route for every claim mask:
+        // no future consumer can distinguish endpoints/fuel at this boundary.
+        // Both scan work and extra bounded bookkeeping are charged before use.
+        std::set<std::uint32_t> seen;
+        std::vector<const ExactOrienteeringRoute*> representatives;
+        for (const auto& route : frontier) {
+            charge(1);
+            if (seen.find(route.spotMask) != seen.end()) continue;
+            charge_actions(2); // One mask node and one route-reference slot.
+            seen.insert(route.spotMask);
+            representatives.push_back(&route);
+        }
+        return representatives;
+    }
+    const Choice& solve(std::int32_t day, Cells pos, Fuels fuel, const BrandMask& brands) {
+        charge(1);
+        const Key key{day, pos, fuel, brands};
+        if (const auto i = memo.find(key); i != memo.end()) return i->second;
+        if (work.memoStates >= limits.memo) throw Exhausted{};
+        ++work.memoStates;
+        if (day > config.day_count()) {
+            return memo.emplace(key, Choice{{brand_count(brands), 0, 0}, pos, fuel, brands, {}}).first->second;
+        }
+        std::optional<Choice> best;
+        const auto& left = routes(day, pos[0], fuel[0]);
+        const auto& right = routes(day, pos[1], fuel[1]);
+        if (day == config.day_count()) {
+            const auto firstRoutes = terminal_representatives(left);
+            const auto secondRoutes = terminal_representatives(right);
+            for (const auto* first : firstRoutes) {
+                for (const auto* second : secondRoutes) {
+                    charge(1);
+                    const auto [dailyBrands, servings] = day_score(
+                        day, first->spotMask, second->spotMask);
+                    const BrandMask nextBrands = brands | dailyBrands;
+                    const OfficialScore value{
+                        brand_count(nextBrands), brand_count(dailyBrands), servings};
+                    if (!best || best->score < value) {
+                        best = Choice{value,
+                            {first->terminalCell, second->terminalCell},
+                            {fuel[0] - first->patrolFuel, fuel[1] - second->patrolFuel},
+                            nextBrands, {first, second}};
+                    }
+                }
+            }
+            if (!best) throw InvalidWitness{};
+            return memo.emplace(key, std::move(*best)).first->second;
+        }
+
+        for (const auto& first : left) {
+            for (const auto& second : right) {
+                charge(1); // Joint cross product: never prune an individually losing route.
+                const auto [dailyBrands, servings] = day_score(day, first.spotMask, second.spotMask);
+                const BrandMask nextBrands = brands | dailyBrands;
+                const Cells nextPos{first.terminalCell, second.terminalCell};
+                const Fuels nextFuel{fuel[0] - first.patrolFuel, fuel[1] - second.patrolFuel};
+                if (best) {
+                    auto bound = optimistic(day + 1, nextPos, nextFuel, nextBrands);
+                    bound.totalDailyDistinct += brand_count(dailyBrands);
+                    bound.totalServings += servings;
+                    // A previous exact choice wins all equal-score ties.
+                    if (!(best->score < bound)) { ++auditCuts; continue; }
+                }
+                auto value = solve(day + 1, nextPos, nextFuel, nextBrands).score;
+                value.totalDailyDistinct += brand_count(dailyBrands);
+                value.totalServings += servings;
+                if (!best || best->score < value)
+                    best = Choice{value, nextPos, nextFuel, nextBrands, {&first, &second}};
+            }
+        }
+        if (!best) throw InvalidWitness{};
+        return memo.emplace(key, std::move(*best)).first->second;
+    }
+public:
+    Pricing(const MatchConfig& c, const DayState& s, const MatchLedger& l,
+            const FutureWitness& w, const ExactStepSimulator& sim,
+            const IndependentDayValidator& val, std::chrono::steady_clock::time_point end,
+            HorizonPricingDiagnostics& d, const HorizonPricingLimits& bound)
+        : config(c), root(s), ledger(l), original(w), simulator(sim), validator(val),
+          deadline(end), totals(d), limits(bound) {}
+    ~Pricing() {
+        totals.settledLabels += work.settledLabels;
+        totals.createdLabels += work.createdLabels;
+        totals.storedActions += work.storedActions;
+        totals.memoStates += work.memoStates;
+        totals.transitions += work.transitions;
+        totals.dayQueries += work.dayQueries;
+    }
+    std::optional<FutureWitness> run() {
+        if (!original.certified || original.lowerBoundOnly || original.futurePlans.size() !=
+            static_cast<std::size_t>(config.day_count() - root.dayNumber + 1)) throw InvalidWitness{};
+        auto state = root;
+        auto prefix = ledger;
+        std::uint64_t originalActions = 0;
+        for (const auto& plan : original.futurePlans) {
+            check();
+            for (const auto& actions : plan.actions) {
+                originalActions += actions.size();
+                if (originalActions > limits.actions) throw Exhausted{};
+                charge_actions(actions.size());
+            }
+            auto sim = simulate(state, plan);
+            std::vector<std::uint32_t> masks(static_cast<std::size_t>(config.agent_count()), 0U);
+            for (const auto& claim : sim.claims)
+                masks.at(claim.agent) |= std::uint32_t{1} << static_cast<std::uint32_t>(claim.spot);
+            fixedClaims.push_back(std::move(masks));
+            fixedStates.push_back(sim.finalAgents);
+            state.agents = sim.finalAgents;
+            ++state.dayNumber;
+            prefix.apply(sim.score);
+        }
+        if (OfficialScore{prefix.lifetime_distinct(), prefix.totalDailyDistinct, prefix.totalServings} != original.score)
+            throw InvalidWitness{};
+        std::optional<FutureWitness> best;
+        for (pair[0] = 0; pair[0] < config.agent_count(); ++pair[0]) {
+          for (pair[1] = pair[0] + 1; pair[1] < config.agent_count(); ++pair[1]) {
+            // Independent ORIGINAL-root responses; shared invocation counters/cache.
+            memo.clear();
+            prepare_relaxation();
+            auto cells = [&](const DayState& s) { return Cells{s.agents.at(pair[0]).position, s.agents.at(pair[1]).position}; };
+            auto fuels = [&](const DayState& s) { return Fuels{s.agents.at(pair[0]).fuel, s.agents.at(pair[1]).fuel}; };
+            auto expected = solve(root.dayNumber, cells(root), fuels(root), ledger.lifetimeBrands).score;
+            expected.totalDailyDistinct += ledger.totalDailyDistinct;
+            expected.totalServings += ledger.totalServings;
+            if (expected < original.score) throw InvalidWitness{};
+            FutureWitness candidate;
+            candidate.certified = true;
+            auto actual = root;
+            auto actualLedger = ledger;
+            for (std::int32_t day = root.dayNumber; day <= config.day_count(); ++day) {
+                check();
+                const auto node = solve(day, cells(actual), fuels(actual), actualLedger.lifetimeBrands);
+                const auto& originalPlan = original.futurePlans.at(day - root.dayNumber);
+                for (const auto& actions : originalPlan.actions) charge_actions(actions.size());
+                for (int i = 0; i < 2; ++i) charge_actions(node.route[i]->actions.size());
+                auto plan = originalPlan;
+                for (int i = 0; i < 2; ++i) plan.actions.at(pair[i]) = node.route[i]->actions;
+                const auto sim = simulate(actual, plan);
+                for (AgentIndex a = 0; a < config.agent_count(); ++a)
+                    if (a != pair[0] && a != pair[1] &&
+                        (sim.finalAgents.at(a).position != fixedStates.at(day - root.dayNumber).at(a).position ||
+                         sim.finalAgents.at(a).fuel != fixedStates.at(day - root.dayNumber).at(a).fuel))
+                        throw InvalidWitness{};
+                for (int i = 0; i < 2; ++i)
+                    if (sim.finalAgents.at(pair[i]).position != node.pos[i] ||
+                        sim.finalAgents.at(pair[i]).fuel != node.fuel[i]) throw InvalidWitness{};
+                actualLedger.apply(sim.score);
+                if (actualLedger.lifetimeBrands != node.brands) throw InvalidWitness{};
+                actual.agents = sim.finalAgents;
+                ++actual.dayNumber;
+                candidate.futurePlans.push_back(std::move(plan));
+            }
+            candidate.score = {actualLedger.lifetime_distinct(), actualLedger.totalDailyDistinct, actualLedger.totalServings};
+            if (candidate.score != expected) throw InvalidWitness{};
+            if (original.score < candidate.score && (!best || best->score < candidate.score)) best = std::move(candidate);
+          }
+        }
+        check();
+        ++totals.completed;
+        if (best) ++totals.improvements;
+        return best;
+    }
+};
