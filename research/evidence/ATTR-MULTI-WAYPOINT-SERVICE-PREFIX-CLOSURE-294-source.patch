+
+[[nodiscard]] AgentPlan multi_rendezvous_provider_actions(
+    const MatchConfig& config,
+    const DayState& state,
+    std::int32_t initialWait,
+    const ParetoPath& firstArrival,
+    const ParetoPath& secondArrival) {
+    const std::int32_t used = initialWait + firstArrival.travelSteps + 1 +
+        secondArrival.travelSteps + 1;
+    const std::int32_t daySteps = config.steps_for_day(state.dayNumber);
+    if (initialWait < 0 || used > daySteps) {
+        throw std::invalid_argument(
+            "multi-rendezvous provider route exceeds the current day budget");
+    }
+    AgentPlan result;
+    result.reserve(static_cast<std::size_t>(
+        firstArrival.directions.size() + secondArrival.directions.size() + 4U));
+    if (initialWait > 0) {
+        result.push_back(PlanAction::wait(initialWait));
+    }
+    for (const std::int32_t direction : firstArrival.directions) {
+        result.push_back(PlanAction::move(direction));
+    }
+    result.push_back(PlanAction::wait(1));
+    for (const std::int32_t direction : secondArrival.directions) {
+        result.push_back(PlanAction::move(direction));
+    }
+    result.push_back(PlanAction::wait(1));
+    const std::int32_t remaining = daySteps - used;
+    if (remaining > 0) {
+        result.push_back(PlanAction::wait(remaining));
+    }
+    return result;
+}
