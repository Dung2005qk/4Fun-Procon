+void test_multi_waypoint_service_group_is_atomic(
+    const udon::MatchConfig& config,
+    const udon::DayState& state) {
+    udon::DayState atomicState = state;
+    atomicState.agents.at(0).position = 16;
+    atomicState.agents.at(0).fuel = 1;
+    atomicState.agents.at(1).position = 16;
+    atomicState.agents.at(2).position = 16;
+    atomicState.agents.at(2).fuel = 1;
+    const std::uint32_t requiredMask = 0b111U;
+    const udon::RefuelEvent event{16, 1};
+    const auto make_wait = [&config](udon::AgentIndex agent) {
+        udon::RouteColumn column;
+        column.columnId = agent;
+        column.agent = agent;
+        column.actions = udon::AgentPlan{
+            udon::PlanAction::wait(config.steps_for_day(1))};
+        column.terminalCell = 16;
+        return column;
+    };
+
+    udon::RoutePortfolio complete;
+    complete.columnsByAgent.resize(3U);
+    udon::RouteColumn firstConsumer = make_wait(0);
+    firstConsumer.multiWaypointTankerConsumer = true;
+    firstConsumer.multiWaypointServiceGroup = 7;
+    firstConsumer.multiWaypointServiceAgentMask = requiredMask;
+    firstConsumer.requiredRefuels.push_back(event);
+    complete.columnsByAgent.at(0).push_back(firstConsumer);
+    udon::RouteColumn provider = make_wait(1);
+    provider.multiWaypointTankerProvider = true;
+    provider.multiWaypointServiceGroup = 7;
+    provider.multiWaypointServiceAgentMask = requiredMask;
+    provider.providedRefuels.push_back(event);
+    complete.columnsByAgent.at(1).push_back(provider);
+    udon::RouteColumn secondConsumer = make_wait(2);
+    secondConsumer.multiWaypointTankerConsumer = true;
+    secondConsumer.multiWaypointServiceGroup = 7;
+    secondConsumer.multiWaypointServiceAgentMask = requiredMask;
+    secondConsumer.requiredRefuels.push_back(event);
+    complete.columnsByAgent.at(2).push_back(secondConsumer);
+
+    const udon::ExactStepSimulator simulator(config);
+    const udon::IndependentDayValidator validator(config);
+    const udon::RouteMaster master(config, simulator, validator);
+    udon::MasterOptions options;
+    options.maximumCombinations = 1;
+    options.maximumCandidates = 1;
+    options.maximumResolveRounds = 1;
+    udon::MasterDiagnostics diagnostics;
+    require(
+        !master.solve(
+             atomicState,
+             udon::MatchLedger{},
+             complete,
+             options,
+             diagnostics).empty(),
+        "one provider plus both required Patrol consumers must form an admissible atomic group");
+
+    udon::RoutePortfolio incomplete = complete;
+    incomplete.columnsByAgent.at(2).front() = make_wait(2);
+    require(
+        master.solve(
+            atomicState,
+            udon::MatchLedger{},
+            incomplete,
+            options,
+            diagnostics).empty(),
+        "the master must reject a multi-waypoint provider with only one matching consumer");
+
+    udon::RoutePortfolio orphan = complete;
+    orphan.columnsByAgent.at(0).front() = make_wait(0);
+    orphan.columnsByAgent.at(2).front() = make_wait(2);
+    require(
+        master.solve(
+            atomicState,
+            udon::MatchLedger{},
+            orphan,
+            options,
+            diagnostics).empty(),
+        "the master must reject an orphan multi-waypoint Tanker provider");
+}
 
