+        for (std::uint32_t source = 0U; source < cellCount; ++source) {
+            if ((source & 255U) == 0U && deadline_expired()) {
+                return result;
+            }
+            if (config.map.terrain.at(source) == Terrain::Pond) {
+                continue;
+            }
+            for (std::int32_t direction = 0;
+                 direction < kDirectionCount;
+                 ++direction) {
+                const CellId destination = config.map.neighbors.at(source).at(
+                    static_cast<std::size_t>(direction));
+                if (destination != kInvalidCell &&
+                    config.map.terrain.at(
+                        static_cast<std::size_t>(destination)) !=
+                        Terrain::Pond) {
+                    predecessors.at(static_cast<std::size_t>(destination))
+                        .push_back(static_cast<CellId>(source));
+                }
+            }
+        }
+        const auto build_bound =
+            [&predecessors,
+             &moveCosts,
+             &deadline_expired,
+             cellCount,
+             requiredTerminal](bool fuelResource,
+                               std::vector<std::uint16_t>& bound) {
+                bound.assign(cellCount, kUnreachable);
+                using DistanceCell = std::pair<std::uint16_t, CellId>;
+                std::priority_queue<
+                    DistanceCell,
+                    std::vector<DistanceCell>,
+                    std::greater<>> frontier;
+                bound.at(static_cast<std::size_t>(*requiredTerminal)) = 0U;
+                frontier.emplace(0U, *requiredTerminal);
+                std::uint64_t settled = 0U;
+                while (!frontier.empty()) {
+                    if ((settled++ & 255U) == 0U && deadline_expired()) {
+                        return false;
+                    }
+                    const auto [distance, cell] = frontier.top();
+                    frontier.pop();
+                    if (bound.at(static_cast<std::size_t>(cell)) != distance) {
+                        continue;
+                    }
+                    for (const CellId predecessor :
